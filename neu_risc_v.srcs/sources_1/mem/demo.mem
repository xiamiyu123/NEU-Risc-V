// 十六进制机器码 | 汇编指令 | 32 位二进制机器码（每组 4 位）
102030b7 // lui      x1, 0x10203   | 0001 0000 0010 0000 0011 0000 1011 0111
0fa0e093 // ori      x1, x1, 0x0fa | 0000 1111 1010 0000 1110 0000 1001 0011
01020137 // lui      x2, 0x01020   | 0000 0001 0000 0010 0000 0001 0011 0111
41416113 // ori      x2, x2, 0x414 | 0100 0001 0100 0001 0110 0001 0001 0011
0020818b // uadd8sat x3, x1, x2    | 0000 0000 0010 0000 1000 0001 1000 1011
00302023 // sw       x3, 0(x0)     | 0000 0000 0011 0000 0010 0000 0010 0011
0000006f // jal      x0, 0         | 0000 0000 0000 0000 0000 0000 0110 1111
@ff // 下一条写入字索引 0xff，对应字节地址 0x3fc。
0000006f // jal      x0, 0         | 0000 0000 0000 0000 0000 0000 0110 1111
