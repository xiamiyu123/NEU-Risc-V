+    integer    byte_i;     // 字节循环下标 0..3，对应 bit[7:0]/[15:8]/[23:16]/[31:24]
 
     always @* begin
+        //---------------------------------------------------------------------
+        // 第 1 段：预先计算 uadd8sat（4 路字节饱和加法）的结果
+        //   把 a、b 各拆成 4 个独立字节，逐字节相加；
+        //   每对字节的和若 >= 256，则“饱和”截断为 0xFF，否则保留原和。
