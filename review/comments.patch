-            ALU_SLT: result = $signed(a) < $signed(b);
-            ALU_SLTU: result = a < b;
-            ALU_XOR: result = a ^ b;
-            ALU_OR: result = a | b;
-            ALU_AND: result = a & b;
-            ALU_LUI: result = b;
-            ALU_SLL: result = a << b[4:0];
-            ALU_SRL: result = a >> b[4:0];
